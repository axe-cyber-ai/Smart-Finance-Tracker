# Smart Finance Tracker — Environment Configuration Template

# Server settings
PORT=3000
APP_NAME="Smart Finance Tracker"
APP_ENV=local # local | staging | production
APP_URL=http://localhost:3000

# Database Connection (Prisma / PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/smart_finance_db"

# Express Session Secret (CRITICAL: Must be a long, random string in production!)
SESSION_SECRET="change-this-to-a-strong-random-secret-key-in-production"

# OpenAI API key & Model (For AI Financial Advisor)
SERVICES_AI_SECRET="your-openai-api-key-here"
SERVICES_AI_MODEL="gpt-4o-mini"

