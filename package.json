    "helmet": "^8.3.0",
    "marked": "^18.0.11",
    "openai": "^4.28.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.0",
