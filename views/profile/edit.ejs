<div class="max-w-4xl space-y-8 font-manrope">
    
    <div>
        <h2 class="text-2xl font-graphik font-bold text-white uppercase tracking-tight">[ PROFILE_&_SETTINGS ]</h2>
        <p class="text-xs text-white/50">Shaxsiy ma'lumotlaringizni va xavfsizlik parolingizni yangilang</p>
    </div>

    <!-- Personal Info Card -->
    <div class="cyber-card p-6 sm:p-10 space-y-6">
        <div class="border-b border-white/10 pb-4">
            <h3 class="text-base font-graphik font-bold text-white uppercase tracking-wider">Shaxsiy Ma'lumotlar</h3>
            <p class="text-xs text-white/50">Ismingiz va email manzilingizni o'zgartiring</p>
        </div>

        <form method="POST" action="/profile" class="space-y-5">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

            <!-- Name -->
            <div>
                <label for="name" class="block text-xs font-bold text-white/70 uppercase tracking-wider mb-2">Ism va Familiya</label>
                <input type="text" id="name" name="name" value="<%= user.name %>" required
                       class="w-full bg-white/5 border border-white/10 px-4 py-3.5 text-white text-sm focus:outline-none focus:border-[#AFDDFF]">
            </div>

            <!-- Email -->
            <div>
                <label for="email" class="block text-xs font-bold text-white/70 uppercase tracking-wider mb-2">Email Manzil</label>
                <input type="email" id="email" name="email" value="<%= user.email %>" required
                       class="w-full bg-white/5 border border-white/10 px-4 py-3.5 text-white text-sm focus:outline-none focus:border-[#AFDDFF]">
            </div>

            <div class="border-t border-white/10 pt-6 space-y-4">
                <h4 class="text-sm font-graphik font-bold text-white uppercase tracking-wider">Parolni O'zgartirish (Ixtiyoriy)</h4>
                
                <!-- Current Password -->
                <div>
                    <label for="current_password" class="block text-xs font-bold text-white/70 uppercase tracking-wider mb-2">Joriy Parol</label>
                    <input type="password" id="current_password" name="current_password"
                           class="w-full bg-white/5 border border-white/10 px-4 py-3.5 text-white text-sm focus:outline-none focus:border-[#AFDDFF]">
                </div>

                <!-- New Password -->
                <div>
                    <label for="password" class="block text-xs font-bold text-white/70 uppercase tracking-wider mb-2">Yangi Parol</label>
                    <input type="password" id="password" name="password"
                           class="w-full bg-white/5 border border-white/10 px-4 py-3.5 text-white text-sm focus:outline-none focus:border-[#AFDDFF]">
                </div>

                <!-- Confirm Password -->
                <div>
                    <label for="password_confirmation" class="block text-xs font-bold text-white/70 uppercase tracking-wider mb-2">Yangi Parolni Tasdiqlang</label>
                    <input type="password" id="password_confirmation" name="password_confirmation"
                           class="w-full bg-white/5 border border-white/10 px-4 py-3.5 text-white text-sm focus:outline-none focus:border-[#AFDDFF]">
                </div>
            </div>

            <!-- Submit Button -->
            <div class="pt-4 flex justify-end">
                <button type="submit"
                        class="bg-[#AFDDFF] hover:bg-[#c8e8ff] text-black px-[24px] py-[12px] flex items-center gap-[10px] font-bold text-xs uppercase tracking-wide">
                    <span>&#10022;</span>
                    <span>O'zgarishlarni Saqlash</span>
                </button>
            </div>
        </form>
    </div>

</div>
