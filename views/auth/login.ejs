<div class="w-full min-h-screen grid grid-cols-1 lg:grid-cols-2 font-manrope">
    
    <!-- Left 50% Full Screen Half: Branding & Logo Panel -->
    <div class="relative min-h-screen bg-gradient-to-br from-[#0A0E1A] via-black to-[#050811] p-8 sm:p-12 lg:p-16 flex flex-col justify-between overflow-hidden border-b lg:border-b-0 lg:border-r border-white/10">
        
        <!-- Background Grid Lines -->
        <div class="absolute inset-0 pointer-events-none opacity-40">
            <div class="absolute top-0 left-[30%] h-full w-px bg-white/[0.05]"></div>
            <div class="absolute top-0 left-[70%] h-full w-px bg-white/[0.05]"></div>
            <div class="absolute top-[35%] left-0 w-full h-px bg-white/[0.05]"></div>
            <div class="absolute top-[75%] left-0 w-full h-px bg-white/[0.05]"></div>
        </div>

        <!-- Ambient Glow -->
        <div class="absolute -left-20 -top-20 w-96 h-96 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Top Logo -->
        <div class="space-y-8 relative z-10">
            <div class="flex items-center gap-3.5">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-emerald-400 via-teal-400 to-cyan-500 flex items-center justify-center font-bold text-slate-950 text-3xl shadow-xl shadow-emerald-500/20">
                    ⚡
                </div>
                <div>
                    <h1 class="font-graphik font-extrabold text-white text-3xl tracking-tight">
                        Smart<span class="bg-gradient-to-r from-emerald-400 to-teal-300 bg-clip-text text-transparent">Finance</span>
                    </h1>
                    <p class="text-xs text-emerald-400 font-mono tracking-widest uppercase">ECOSYSTEM 2.0</p>
                </div>
            </div>

            <div class="space-y-4 pt-6 max-w-xl">
                <h2 class="text-3xl sm:text-5xl font-graphik font-extrabold text-white leading-[1.1] tracking-tight">
                    Shaxsiy Moliyangizni <br>
                    <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">Aqlli Boshqaring.</span>
                </h2>
                <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-md">
                    Real vaqt rejimida daromad, xarajat hamda byudjetlaringizni kuzating va sun'iy intellekt tahlillarini oling.
                </p>
            </div>
        </div>

        <!-- Bottom Feature Chips -->
        <div class="space-y-4 pt-12 relative z-10 border-t border-white/10">
            <div class="flex items-center gap-3 text-xs sm:text-sm text-slate-300 font-medium">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-lg shadow-emerald-400/50"></span>
                <span>Real vaqt rejimida moliyaviy balans va tranzaksiyalar</span>
            </div>
            <div class="flex items-center gap-3 text-xs sm:text-sm text-slate-300 font-medium">
                <span class="w-2.5 h-2.5 rounded-full bg-teal-400 shadow-lg shadow-teal-400/50"></span>
                <span>AI Anomaliyalar va shaxsiy tejash maslahatlari</span>
            </div>
            <div class="flex items-center gap-3 text-xs sm:text-sm text-slate-300 font-medium">
                <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 shadow-lg shadow-cyan-400/50"></span>
                <span>Oylik byudjet limitlari va avtomatik ogohlantirishlar</span>
            </div>
        </div>

    </div>

    <!-- Right 50% Full Screen Half: Form Panel -->
    <div class="min-h-screen bg-[#050811] p-8 sm:p-12 lg:p-20 flex flex-col justify-center relative">
        
        <div class="max-w-md w-full mx-auto space-y-8">
            
            <div>
                <h3 class="text-3xl font-graphik font-extrabold text-white tracking-tight">Tizimga Kirish</h3>
                <p class="text-xs sm:text-sm text-slate-400 mt-2">Davom etish uchun login va parolingizni kiriting</p>
            </div>

            <% if(typeof success !== 'undefined' && success) { %>
                <div class="p-4 rounded-2xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-semibold">
                    <%= success %>
                </div>
            <% } %>

            <% if(typeof error !== 'undefined' && error) { %>
                <div class="p-4 rounded-2xl bg-rose-500/15 border border-rose-500/30 text-rose-300 text-xs font-semibold">
                    <%= error %>
                </div>
            <% } %>

            <form method="POST" action="/login" class="space-y-6">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

                <!-- Login / Email -->
                <div>
                    <label for="email" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Login / Email</label>
                    <input type="text" id="email" name="email" required autofocus placeholder="Login yoki email kiriting..."
                           class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-slate-100 text-sm focus:outline-none focus:border-emerald-500 transition-colors font-mono">
                </div>

                <!-- Password -->
                <div>
                    <label for="password" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Parol</label>
                    <input type="password" id="password" name="password" required placeholder="Parolingizni kiriting..."
                           class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-slate-100 text-sm focus:outline-none focus:border-emerald-500 transition-colors font-mono">
                </div>

                <!-- Submit Button -->
                <button type="submit"
                        class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-emerald-400 via-teal-400 to-emerald-500 text-slate-950 font-space font-extrabold text-sm shadow-xl shadow-emerald-500/25 hover:shadow-emerald-500/40 hover:scale-[1.02] transition-all active:scale-95 flex items-center justify-center gap-2">
                    <span>🔑</span>
                    <span>Kirish</span>
                </button>
            </form>

            <div class="text-center pt-6 border-t border-white/10">
                <p class="text-xs sm:text-sm text-slate-400">
                    Akkauntingiz yo'qmi?
                    <a href="/register" class="font-bold text-emerald-400 hover:underline">Ro'yxatdan o'ting</a>
                </p>
            </div>

        </div>

    </div>

</div>
