<div class="space-y-8 font-manrope">
    
    <!-- Top Hero Banner -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-white/10 pb-6">
        <div class="space-y-1">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/40 text-[11px] font-bold uppercase tracking-wider">
                👑 Super Admin Management
            </div>
            <h2 class="text-2xl sm:text-3xl font-graphik font-bold text-white uppercase tracking-tight">Admin Boshqaruv Paneli</h2>
            <p class="text-xs text-white/50">Tizim foydalanuvchilari, tranzaksiyalar va global platforma ko'rsatkichlari</p>
        </div>

        <div class="flex items-center gap-3">
            <span class="px-3 py-1.5 rounded-xl bg-purple-500/20 border border-purple-500/40 text-purple-300 text-xs font-mono font-bold">
                ROLE: ADMINISTRATOR
            </span>
        </div>
    </div>

    <!-- 4 KPI Cards for Admin -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <div class="cyber-card p-6 space-y-2 border-purple-500/30">
            <span class="text-[11px] font-bold text-purple-300 uppercase tracking-wider">[ JAMI FOYDALANUVCHILAR ]</span>
            <p class="text-3xl font-graphik font-bold text-white"><%= totalUsers %> <span class="text-xs font-manrope text-purple-300">ta</span></p>
            <p class="text-[10px] text-white/50">Ro'yxatdan o'tgan akkauntlar</p>
        </div>

        <div class="cyber-card p-6 space-y-2 border-emerald-500/30">
            <span class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider">[ JAMI TRANZAKSIYALAR ]</span>
            <p class="text-3xl font-graphik font-bold text-emerald-400"><%= totalTransactions %> <span class="text-xs font-manrope text-white/70">ta</span></p>
            <p class="text-[10px] text-white/50">Tizimdagi barcha yozuvlar</p>
        </div>

        <div class="cyber-card p-6 space-y-2 border-blue-500/30">
            <span class="text-[11px] font-bold text-blue-400 uppercase tracking-wider">[ KATEGORIYALAR POOL ]</span>
            <p class="text-3xl font-graphik font-bold text-blue-300"><%= totalCategories %> <span class="text-xs font-manrope text-white/70">ta</span></p>
            <p class="text-[10px] text-white/50">Tizim va shaxsiy turlar</p>
        </div>

        <div class="cyber-card p-6 space-y-2 border-amber-500/30">
            <span class="text-[11px] font-bold text-amber-400 uppercase tracking-wider">[ BYUDJET REJALARI ]</span>
            <p class="text-3xl font-graphik font-bold text-amber-300"><%= totalBudgets %> <span class="text-xs font-manrope text-white/70">ta</span></p>
            <p class="text-[10px] text-white/50">Belgilangan limitlar</p>
        </div>

    </div>

    <!-- Admin Users Table -->
    <div class="cyber-card p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <h3 class="text-base font-graphik font-bold text-white uppercase tracking-wider">[ PLATFORMA FOYDALANUVCHILARI ]</h3>
            <span class="text-xs text-purple-300 font-mono bg-purple-500/20 px-3 py-1 rounded-xl border border-purple-500/30">User Control</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-white">
                <thead class="text-[11px] font-bold text-white/50 uppercase tracking-wider border-b border-white/10 bg-white/5">
                    <tr>
                        <th class="py-3.5 px-4">ID</th>
                        <th class="py-3.5 px-4">Ism</th>
                        <th class="py-3.5 px-4">Login / Email</th>
                        <th class="py-3.5 px-4">Roli</th>
                        <th class="py-3.5 px-4 text-center">Tranzaksiyalar</th>
                        <th class="py-3.5 px-4 text-center">Byudjetlar</th>
                        <th class="py-3.5 px-4 text-right">Sana</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    <% users.forEach(function(u) { %>
                    <tr class="hover:bg-white/5 transition-colors">
                        <td class="py-3.5 px-4 font-mono text-purple-300 font-bold">#<%= u.id %></td>
                        <td class="py-3.5 px-4 font-bold text-white">
                            <div class="flex items-center gap-2">
                                <span class="w-7 h-7 rounded-lg bg-white/10 text-white flex items-center justify-center font-bold text-xs">
                                    <%= u.name.charAt(0).toUpperCase() %>
                                </span>
                                <span><%= u.name %></span>
                            </div>
                        </td>
                        <td class="py-3.5 px-4 font-mono text-emerald-400 font-bold"><%= u.email %></td>
                        <td class="py-3.5 px-4">
                            <% if(u.role === 'admin') { %>
                                <span class="px-2.5 py-1 rounded-lg bg-purple-500/20 text-purple-300 border border-purple-500/40 text-[10px] font-bold uppercase">ADMIN</span>
                            <% } else { %>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-slate-300 border border-white/20 text-[10px] font-bold uppercase">USER</span>
                            <% } %>
                        </td>
                        <td class="py-3.5 px-4 text-center font-mono font-bold text-white"><%= u._count.transactions %> ta</td>
                        <td class="py-3.5 px-4 text-center font-mono font-bold text-white"><%= u._count.budgets %> ta</td>
                        <td class="py-3.5 px-4 text-right font-mono text-white/50"><%= new Date(u.createdAt).toISOString().split('T')[0] %></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Recent Global System Activity -->
    <div class="cyber-card p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <h3 class="text-base font-graphik font-bold text-white uppercase tracking-wider">[ RECENT_GLOBAL_SYSTEM_LOGS ]</h3>
            <span class="text-xs text-emerald-400 font-mono">Real-time Feed</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-white">
                <thead class="text-[11px] font-bold text-white/50 uppercase tracking-wider border-b border-white/10 bg-white/5">
                    <tr>
                        <th class="py-3 px-4">Foydalanuvchi</th>
                        <th class="py-3 px-4">Kategoriya</th>
                        <th class="py-3 px-4">Turi</th>
                        <th class="py-3 px-4">Tavsif</th>
                        <th class="py-3 px-4 text-right">Summa</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    <% recentTransactions.forEach(function(tx) { %>
                    <tr class="hover:bg-white/5 transition-colors">
                        <td class="py-3 px-4 font-bold text-white"><%= tx.user?.name %> (<%= tx.user?.email %>)</td>
                        <td class="py-3 px-4 text-slate-300"><%= tx.category?.name || 'Standard' %></td>
                        <td class="py-3 px-4 font-bold <%= tx.type === 'income' ? 'text-emerald-400' : 'text-rose-400' %>">
                            <%= tx.type === 'income' ? '[ DAROMAD ]' : '[ XARAJAT ]' %>
                        </td>
                        <td class="py-3 px-4 text-white/70 truncate max-w-xs"><%= tx.description || '-' %></td>
                        <td class="py-3 px-4 text-right font-mono font-bold <%= tx.type === 'income' ? 'text-emerald-400' : 'text-rose-400' %>">
                            <%= tx.amount.toLocaleString('uz-UZ') %> UZS
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

</div>
