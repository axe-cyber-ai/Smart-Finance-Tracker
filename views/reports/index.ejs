<div class="space-y-8 font-manrope">
    
    <!-- Top Action Bar & Date Range Form -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-graphik font-bold text-white uppercase tracking-tight">[ FINANCIAL_REPORTS_&_ANALYTICS ]</h2>
            <p class="text-xs text-white/50">Tanlangan sana oralig'i bo'yicha batafsil daromad va xarajat statistikasi</p>
        </div>

        <form method="GET" action="/reports" class="flex flex-wrap items-center gap-3 bg-white/5 border border-white/10 p-2.5 backdrop-blur-xl w-full md:w-auto">
            <div>
                <input type="date" name="start_date" value="<%= startDate %>" 
                       class="bg-black border border-white/10 px-3 py-1.5 text-xs text-white focus:outline-none">
            </div>
            <span class="text-xs text-white/50 font-bold">—</span>
            <div>
                <input type="date" name="end_date" value="<%= endDate %>" 
                       class="bg-black border border-white/10 px-3 py-1.5 text-xs text-white focus:outline-none">
            </div>
            <button type="submit" class="px-4 py-1.5 bg-[#AFDDFF] hover:bg-[#c8e8ff] text-black font-bold text-xs uppercase tracking-wide">
                Hisobotni Olish
            </button>
        </form>
    </div>

    <!-- Summary KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="cyber-card cyber-card-hover p-[20px] space-y-2">
            <span class="text-[11px] font-bold text-white/70 uppercase tracking-wider">[ TOTAL_INCOME ]</span>
            <p class="text-2xl font-graphik font-bold text-[#AFDDFF]">+<%= totalIncome.toLocaleString('uz-UZ') %> UZS</p>
            <p class="text-[10px] text-white/50">Tanlangan oraliq bo'yicha</p>
        </div>

        <div class="cyber-card cyber-card-hover p-[20px] space-y-2">
            <span class="text-[11px] font-bold text-white/70 uppercase tracking-wider">[ TOTAL_EXPENSE ]</span>
            <p class="text-2xl font-graphik font-bold text-rose-400">-<%= totalExpense.toLocaleString('uz-UZ') %> UZS</p>
            <p class="text-[10px] text-white/50">Tanlangan oraliq bo'yicha</p>
        </div>

        <div class="cyber-card cyber-card-hover p-[20px] space-y-2">
            <span class="text-[11px] font-bold text-white/70 uppercase tracking-wider">[ NET_SAVINGS ]</span>
            <p class="text-2xl font-graphik font-bold <%= netSavings >= 0 ? 'text-[#AFDDFF]' : 'text-rose-400' %>">
                <%= netSavings.toLocaleString('uz-UZ') %> UZS
            </p>
            <p class="text-[10px] text-white/50">Daromad minus Xarajat</p>
        </div>

        <div class="cyber-card cyber-card-hover p-[20px] space-y-2">
            <span class="text-[11px] font-bold text-white/70 uppercase tracking-wider">[ AVG_TRANSACTION ]</span>
            <p class="text-2xl font-graphik font-bold text-white"><%= Math.round(avgTransaction).toLocaleString('uz-UZ') %> UZS</p>
            <p class="text-[10px] text-white/50">Jami <%= transactionCount %> ta yozuvdan</p>
        </div>
    </div>

    <!-- Expense Breakdown Table & Chart -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Table -->
        <div class="lg:col-span-7 cyber-card p-[20px] space-y-4">
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
                <h3 class="text-sm font-graphik font-bold text-white uppercase tracking-wider">[ CATEGORY_BREAKDOWN ]</h3>
                <span class="text-xs font-bold text-rose-400 border border-rose-500/30 px-2 py-0.5">[ EXPENSES ]</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-white">
                    <thead class="text-[11px] font-bold text-white/50 uppercase tracking-wider border-b border-white/10 bg-white/5">
                        <tr>
                            <th class="py-3 px-4">Kategoriya</th>
                            <th class="py-3 px-4 text-center">Yozuvlar</th>
                            <th class="py-3 px-4 text-right">Summa</th>
                            <th class="py-3 px-4 text-right">Ulesh (%)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                        <% if(expenseCategoryBreakdown.length > 0) { %>
                            <% expenseCategoryBreakdown.forEach(function(row) { %>
                            <tr class="hover:bg-white/5 transition-colors">
                                <td class="py-3 px-4 font-semibold text-white">
                                    <div class="flex items-center gap-2.5">
                                        <span class="w-2.5 h-2.5 rounded-full" style="background-color: <%= row.color %>"></span>
                                        <span><%= row.name %></span>
                                    </div>
                                </td>
                                <td class="py-3 px-4 text-center text-white/50"><%= row.count %> ta</td>
                                <td class="py-3 px-4 text-right font-mono font-bold text-white"><%= row.amount.toLocaleString('uz-UZ') %> UZS</td>
                                <td class="py-3 px-4 text-right font-mono font-bold text-[#AFDDFF]"><%= row.percentage %>%</td>
                            </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="py-6 text-center text-white/50">Mavjud emas</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Chart -->
        <div class="lg:col-span-5 cyber-card p-[20px] space-y-4">
            <div class="border-b border-white/10 pb-3">
                <h3 class="text-sm font-graphik font-bold text-white uppercase tracking-wider">[ VISUAL_DISTRIBUTION ]</h3>
                <p class="text-xs text-white/50">Xarajatlar taqsimoti</p>
            </div>
            <div class="h-64 flex items-center justify-center">
                <canvas id="reportExpenseChart"></canvas>
            </div>
        </div>

    </div>

</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const canvas = document.getElementById('reportExpenseChart');
        if (canvas) {
            const data = <%- JSON.stringify(expenseCategoryBreakdown) %>;
            new Chart(canvas, {
                type: 'pie',
                data: {
                    labels: data.map(d => d.name),
                    datasets: [{
                        data: data.map(d => d.amount),
                        backgroundColor: data.map(d => d.color),
                        borderWidth: 2,
                        borderColor: '#000000'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { color: 'rgba(255,255,255,0.7)', font: { family: 'Manrope', size: 11 } }
                        }
                    }
                }
            });
        }
    });
</script>
