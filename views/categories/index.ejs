<div class="space-y-8 font-manrope" x-data="{ createModalOpen: false, editModalOpen: false, editCat: {} }">
    
    <!-- Top Action Bar -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-graphik font-bold text-white uppercase tracking-tight">[ CATEGORIES_CATALOG ]</h2>
            <p class="text-xs text-white/50">Tizim standart va shaxsiy kategoriyalaringiz</p>
        </div>

        <button @click="createModalOpen = true" 
                class="bg-[#AFDDFF] hover:bg-[#c8e8ff] text-black px-[20px] py-[12px] flex items-center gap-[10px] transition-colors font-manrope font-bold text-xs uppercase tracking-wide">
            <span>&#10022;</span>
            <span>Yangi Kategoriya</span>
        </button>
    </div>

    <!-- Section 1: User Custom Categories -->
    <div class="space-y-4">
        <div class="flex items-center justify-between border-b border-white/10 pb-2">
            <h3 class="text-sm font-graphik font-bold text-white uppercase tracking-wider flex items-center gap-2">
                <span>👤 Sizning Shaxsiy Kategoriyalaringiz</span>
            </h3>
            <span class="text-xs text-[#AFDDFF] font-mono border border-[#AFDDFF]/30 px-2 py-0.5">[ CUSTOM ]</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <% if(userCategories.length > 0) { %>
                <% userCategories.forEach(function(cat) { %>
                <div class="cyber-card cyber-card-hover p-5 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="w-3.5 h-3.5 rounded-full flex-shrink-0" style="background-color: <%= cat.color %>"></span>
                        <div>
                            <h4 class="font-bold text-white text-sm"><%= cat.name %></h4>
                            <span class="text-[10px] uppercase font-bold text-white/50"><%= cat.type === 'income' ? 'Daromad' : 'Xarajat' %></span>
                        </div>
                    </div>

                    <div class="flex items-center gap-1">
                        <button @click="editCat = { id: <%= cat.id %>, name: `<%= cat.name %>`, type: `<%= cat.type %>`, color: `<%= cat.color %>`, icon: `<%= cat.icon %>` }; editModalOpen = true"
                                class="p-1.5 text-white/50 hover:text-[#AFDDFF] transition-colors">
                            ✏️
                        </button>
                        <form method="POST" action="/categories/<%= cat.id %>/delete" onsubmit="return confirm('Ushbu kategoriyani o\'chirmoqchimisiz?')">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <button type="submit" class="p-1.5 text-white/50 hover:text-rose-400 transition-colors">🗑️</button>
                        </form>
                    </div>
                </div>
                <% }); %>
            <% } else { %>
                <div class="col-span-full">
                    <%- include('../partials/emptyState', { 
                        title: "Shaxsiy kategoriyalar yo'q", 
                        description: "Siz hali shaxsiy kategoriya yaratmadingiz. Standart tizim kategoriyalaridan foydalanishingiz yoki yangi qo'shishingiz mumkin.", 
                        icon: "🏷️" 
                    }) %>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Section 2: System Default Categories -->
    <div class="space-y-4 pt-4 border-t border-white/10">
        <div class="flex items-center justify-between border-b border-white/10 pb-2">
            <h3 class="text-sm font-graphik font-bold text-white uppercase tracking-wider flex items-center gap-2">
                <span>⚡ Standart Tizim Kategoriyalari</span>
            </h3>
            <span class="text-xs text-white/50 font-mono border border-white/10 px-2 py-0.5">[ SYSTEM ]</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <% systemCategories.forEach(function(cat) { %>
            <div class="cyber-card p-4 flex items-center justify-between opacity-80">
                <div class="flex items-center gap-3">
                    <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: <%= cat.color %>"></span>
                    <div>
                        <h4 class="font-bold text-white text-xs"><%= cat.name %></h4>
                        <span class="text-[9px] uppercase font-bold text-white/40"><%= cat.type === 'income' ? 'Daromad' : 'Xarajat' %></span>
                    </div>
                </div>
                <span class="text-[10px] text-white/40 font-mono">Standart</span>
            </div>
            <% }); %>
        </div>
    </div>

    <!-- Create Category Modal -->
    <div x-show="createModalOpen" class="fixed inset-0 z-50 overflow-y-auto" x-cloak>
        <div class="flex min-h-screen items-center justify-center p-4">
            <div class="fixed inset-0 bg-black/90 backdrop-blur-md" @click="createModalOpen = false"></div>
            <div class="relative w-full max-w-lg bg-black border border-white/20 p-6 sm:p-8 shadow-2xl">
                <div class="flex items-center justify-between border-b border-white/10 pb-4">
                    <h3 class="text-base font-graphik font-bold text-white uppercase tracking-wider">Yangi Shaxsiy Kategoriya</h3>
                    <button @click="createModalOpen = false" class="text-white/50 hover:text-white">✕</button>
                </div>
                <form action="/categories" method="POST" class="mt-4 space-y-4">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <div>
                        <label class="block text-xs font-bold text-white/70 mb-1.5">Kategoriya Nomi</label>
                        <input type="text" name="name" required placeholder="Masalan: Kitoblar" class="w-full bg-white/5 border border-white/10 p-3 text-sm text-white focus:border-[#AFDDFF] focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-white/70 mb-1.5">Turi</label>
                        <select name="type" class="w-full bg-black border border-white/10 p-3 text-sm text-white">
                            <option value="expense">Xarajat</option>
                            <option value="income">Daromad</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-white/70 mb-1.5">Rang Hex Kod</label>
                            <input type="color" name="color" value="#10B981" class="w-full h-11 bg-black border border-white/10 p-1">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-white/70 mb-1.5">Ikonka Nom</label>
                            <input type="text" name="icon" value="tag" class="w-full bg-white/5 border border-white/10 p-3 text-sm text-white">
                        </div>
                    </div>
                    <div class="pt-4 flex justify-end gap-3 border-t border-white/10">
                        <button type="button" @click="createModalOpen = false" class="px-4 py-2 border border-white/20 text-white/70 text-xs">Bekor qilish</button>
                        <button type="submit" class="px-5 py-2 bg-[#AFDDFF] text-black font-bold text-xs uppercase">Saqlash</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Category Modal -->
    <div x-show="editModalOpen" class="fixed inset-0 z-50 overflow-y-auto" x-cloak>
        <div class="flex min-h-screen items-center justify-center p-4">
            <div class="fixed inset-0 bg-black/90 backdrop-blur-md" @click="editModalOpen = false"></div>
            <div class="relative w-full max-w-lg bg-black border border-white/20 p-6 sm:p-8 shadow-2xl">
                <div class="flex items-center justify-between border-b border-white/10 pb-4">
                    <h3 class="text-base font-graphik font-bold text-white uppercase tracking-wider">Kategoriyani Tahrirlash</h3>
                    <button @click="editModalOpen = false" class="text-white/50 hover:text-white">✕</button>
                </div>
                <form :action="'/categories/' + editCat.id + '/update'" method="POST" class="mt-4 space-y-4">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <div>
                        <label class="block text-xs font-bold text-white/70 mb-1.5">Kategoriya Nomi</label>
                        <input type="text" name="name" x-model="editCat.name" required class="w-full bg-white/5 border border-white/10 p-3 text-sm text-white focus:border-[#AFDDFF] focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-white/70 mb-1.5">Turi</label>
                        <select name="type" x-model="editCat.type" class="w-full bg-black border border-white/10 p-3 text-sm text-white">
                            <option value="expense">Xarajat</option>
                            <option value="income">Daromad</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-white/70 mb-1.5">Rang</label>
                            <input type="color" name="color" x-model="editCat.color" class="w-full h-11 bg-black border border-white/10 p-1">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-white/70 mb-1.5">Ikonka</label>
                            <input type="text" name="icon" x-model="editCat.icon" class="w-full bg-white/5 border border-white/10 p-3 text-sm text-white">
                        </div>
                    </div>
                    <div class="pt-4 flex justify-end gap-3 border-t border-white/10">
                        <button type="button" @click="editModalOpen = false" class="px-4 py-2 border border-white/20 text-white/70 text-xs">Bekor qilish</button>
                        <button type="submit" class="px-5 py-2 bg-[#AFDDFF] text-black font-bold text-xs uppercase">Yangilash</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>
