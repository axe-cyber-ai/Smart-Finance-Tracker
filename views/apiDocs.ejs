<div class="space-y-8 font-manrope">
    
    <!-- Top Banner -->
    <div class="border-b border-white/10 pb-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[11px] font-bold uppercase tracking-wider mb-2">
                ⚡ ENTERPRISE REST API v1.0
            </div>
            <h1 class="text-3xl font-graphik font-bold text-white uppercase tracking-tight">PLATFORMA REST API HUJJATLARI</h1>
            <p class="text-xs text-white/50 mt-1">Mobil ilova, telegram bot va 3-tomon tizimlari uchun barcha endpointlar</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1.5 rounded-xl bg-white/5 border border-white/10 text-emerald-400 font-mono text-xs">
                BASE_URL: http://localhost:1234/api/v1
            </span>
        </div>
    </div>

    <!-- API Overview Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="cyber-card p-4 space-y-1.5 border-emerald-500/30">
            <span class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider">[ JSON Standard ]</span>
            <p class="text-xs text-white/70">Barcha API lar `success`, `message`, `data` kalitlari bilan qaytadi.</p>
        </div>
        <div class="cyber-card p-4 space-y-1.5 border-purple-500/30">
            <span class="text-[11px] font-bold text-purple-300 uppercase tracking-wider">[ Auth & Session ]</span>
            <p class="text-xs text-white/70">Sessiya yoki token orqali kirish avtomatik tekshiriladi.</p>
        </div>
        <div class="cyber-card p-4 space-y-1.5 border-blue-500/30">
            <span class="text-[11px] font-bold text-blue-300 uppercase tracking-wider">[ Data Export ]</span>
            <p class="text-xs text-white/70">JSON va zaxira arxiv kodi olish imkoniyati mavjud.</p>
        </div>
        <div class="cyber-card p-4 space-y-1.5 border-amber-500/30">
            <span class="text-[11px] font-bold text-amber-400 uppercase tracking-wider">[ Admin Access ]</span>
            <p class="text-xs text-white/70">Adminlar uchun foydalanuvchilar va platforma statistikasi API lari.</p>
        </div>
    </div>

    <!-- Endpoints List -->
    <div class="space-y-6">

        <!-- Group 1: Auth & Profile Endpoints -->
        <div class="cyber-card p-6 space-y-4">
            <h3 class="text-base font-graphik font-bold text-white uppercase border-b border-white/10 pb-3 flex items-center gap-2">
                <span>🔑</span>
                <span>1. AUTHENTICATION & PROFILE API</span>
            </h3>

            <div class="space-y-4 text-xs font-mono">
                
                <!-- 1.1 Login -->
                <div class="p-4 bg-white/5 border border-white/10 rounded-2xl space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <span class="px-2.5 py-1 bg-emerald-500 text-slate-950 font-bold text-[10px] uppercase rounded-lg">POST</span>
                            <span class="text-white font-bold">/api/v1/auth/login</span>
                        </div>
                        <span class="text-white/50 text-[11px] font-sans">Tizimga kirish</span>
                    </div>
                </div>

                <!-- 1.2 Profile Update -->
                <div class="p-4 bg-white/5 border border-white/10 rounded-2xl space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <span class="px-2.5 py-1 bg-amber-500 text-slate-950 font-bold text-[10px] uppercase rounded-lg">PUT</span>
                            <span class="text-white font-bold">/api/v1/profile</span>
                        </div>
                        <span class="text-white/50 text-[11px] font-sans">Ism va emailni yangilash</span>
                    </div>
                </div>

                <!-- 1.3 Password Update -->
                <div class="p-4 bg-white/5 border border-white/10 rounded-2xl space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <span class="px-2.5 py-1 bg-amber-500 text-slate-950 font-bold text-[10px] uppercase rounded-lg">PUT</span>
                            <span class="text-white font-bold">/api/v1/profile/password</span>
                        </div>
                        <span class="text-white/50 text-[11px] font-sans">Parolni o'zgartirish</span>
                    </div>
                </div>

            </div>
        </div>

        <!-- Group 2: Export & Admin API -->
        <div class="cyber-card p-6 space-y-4">
            <h3 class="text-base font-graphik font-bold text-white uppercase border-b border-white/10 pb-3 flex items-center gap-2">
                <span>📂</span>
                <span>2. EXPORT & ADMIN API</span>
            </h3>

            <div class="space-y-4 text-xs font-mono">
                
                <div class="p-4 bg-white/5 border border-white/10 rounded-2xl flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="px-2.5 py-1 bg-blue-500 text-white font-bold text-[10px] uppercase rounded-lg">GET</span>
                        <span class="text-white font-bold">/api/v1/export/json</span>
                    </div>
                    <span class="text-white/50 text-[11px] font-sans">Barcha tranzaksiya va byudjetlarni JSON shaklida eksport qilish (Zaxira)</span>
                </div>

                <div class="p-4 bg-white/5 border border-white/10 rounded-2xl flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="px-2.5 py-1 bg-purple-500 text-white font-bold text-[10px] uppercase rounded-lg">GET</span>
                        <span class="text-white font-bold">/api/v1/admin/stats</span>
                    </div>
                    <span class="text-white/50 text-[11px] font-sans">Admin uchun platforma statistikasi</span>
                </div>

                <div class="p-4 bg-white/5 border border-white/10 rounded-2xl flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="px-2.5 py-1 bg-purple-500 text-white font-bold text-[10px] uppercase rounded-lg">GET</span>
                        <span class="text-white font-bold">/api/v1/admin/users</span>
                    </div>
                    <span class="text-white/50 text-[11px] font-sans">Admin uchun foydalanuvchilar ro'yxati</span>
                </div>

            </div>
        </div>

    </div>

</div>
