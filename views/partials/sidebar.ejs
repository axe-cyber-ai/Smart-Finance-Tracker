<!-- Mobile Navigation Drawer -->
<div x-show="menuOpen" 
     x-transition:enter="transition ease-out duration-300"
     x-transition:enter-start="opacity-0"
     x-transition:enter-end="opacity-100"
     x-transition:leave="transition ease-in duration-200"
     x-transition:leave-start="opacity-100"
     x-transition:leave-end="opacity-0"
     class="fixed inset-0 z-50 lg:hidden" x-cloak>
    
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/90 backdrop-blur-md" @click="menuOpen = false"></div>

    <!-- Drawer Panel -->
    <div class="relative h-full w-full max-w-xs bg-[#0A0E1A] border-r border-white/10 p-6 flex flex-col justify-between z-10 font-manrope">
        
        <div class="space-y-6">
            <!-- Header -->
            <div class="flex items-center justify-between border-b border-white/10 pb-4">
                <a href="/dashboard" class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-emerald-400 to-teal-400 flex items-center justify-center font-bold text-slate-950 text-sm">
                        ⚡
                    </div>
                    <span class="font-graphik font-extrabold text-white text-base">
                        Smart<span class="text-emerald-400">Finance</span>
                    </span>
                </a>
                <button @click="menuOpen = false" class="p-2 text-slate-400 hover:text-white">✕</button>
            </div>

            <!-- Nav Links List -->
            <nav class="space-y-2">
                <a href="/dashboard" @click="menuOpen = false" 
                   class="flex items-center gap-3 p-3 rounded-2xl text-xs font-bold transition-all <%= req.path === '/dashboard' ? 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30' : 'text-slate-300 hover:bg-white/5' %>">
                    <span>📊</span>
                    <span>Asosiy Panel</span>
                </a>

                <a href="/transactions" @click="menuOpen = false" 
                   class="flex items-center gap-3 p-3 rounded-2xl text-xs font-bold transition-all <%= req.path.startsWith('/transactions') ? 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30' : 'text-slate-300 hover:bg-white/5' %>">
                    <span>💳</span>
                    <span>Tranzaksiyalar</span>
                </a>

                <a href="/budgets" @click="menuOpen = false" 
                   class="flex items-center gap-3 p-3 rounded-2xl text-xs font-bold transition-all <%= req.path.startsWith('/budgets') ? 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30' : 'text-slate-300 hover:bg-white/5' %>">
                    <span>🎯</span>
                    <span>Byudjetlar</span>
                </a>

                <a href="/ai-assistant" @click="menuOpen = false" 
                   class="flex items-center gap-3 p-3 rounded-2xl text-xs font-bold transition-all <%= req.path.startsWith('/ai-assistant') ? 'bg-purple-500/20 text-purple-300 border border-purple-500/40' : 'text-slate-300 hover:bg-white/5' %>">
                    <span>🤖</span>
                    <span>AI Maslahatchi</span>
                </a>

                <a href="/reports" @click="menuOpen = false" 
                   class="flex items-center gap-3 p-3 rounded-2xl text-xs font-bold transition-all <%= req.path.startsWith('/reports') ? 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30' : 'text-slate-300 hover:bg-white/5' %>">
                    <span>📈</span>
                    <span>Hisobotlar</span>
                </a>

                <a href="/categories" @click="menuOpen = false" 
                   class="flex items-center gap-3 p-3 rounded-2xl text-xs font-bold transition-all <%= req.path.startsWith('/categories') ? 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30' : 'text-slate-300 hover:bg-white/5' %>">
                    <span>🏷️</span>
                    <span>Kategoriyalar</span>
                </a>

                <a href="/profile" @click="menuOpen = false" 
                   class="flex items-center gap-3 p-3 rounded-2xl text-xs font-bold transition-all <%= req.path.startsWith('/profile') ? 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30' : 'text-slate-300 hover:bg-white/5' %>">
                    <span>👤</span>
                    <span>Profil Sozlamalari</span>
                </a>
            </nav>
        </div>

        <!-- User Info Footer -->
        <div class="border-t border-white/10 pt-4 flex items-center justify-between text-xs">
            <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">
                    <%= user ? user.name.charAt(0).toUpperCase() : 'A' %>
                </span>
                <div>
                    <p class="font-bold text-white"><%= user ? user.name : 'Ali' %></p>
                    <p class="text-[10px] text-slate-400 truncate max-w-[120px]"><%= user ? user.email : '' %></p>
                </div>
            </div>
        </div>

    </div>
</div>
